# Segredo para assinar a sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Liga o login/registro SIMULADOS (sem backend). Deixe vazio/false em qualquer ambiente com dados reais.
DEMO_MODE=true

# Monitoramento de erros (opcional): só Sentry, sem session replay.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_APP_ENV=development
