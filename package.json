{
  "name": "psycare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "lint:biome": "biome check --write src/components/AppProviders.tsx src/components/AppShellSkeleton.tsx src/components/PageTransition.tsx src/components/ui/skeleton.tsx src/lib/observability/client.ts src/test/setup.ts src/lib/utils.test.ts src/app/loading.tsx src/app/dashboard/loading.tsx src/app/dashboard/template.tsx src/app/dashboard/layout.tsx src/app/(auth)/loading.tsx tests/e2e/smoke.spec.ts vitest.config.ts playwright.config.ts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "quality:arch": "depcruise --config .dependency-cruiser.cjs src",
    "quality:knip": "knip --no-exit-code",
    "quality:all": "npm run lint:eslint && npm run lint:biome && npm run quality:arch && npm run quality:knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "npm run test:coverage && npm run test:e2e",
    "mutate": "stryker run",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "check": "npm run typecheck && npm run quality:all && npm run test"
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.15.0",
    "@newrelic/browser-agent": "^1.323.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@sentry/nextjs": "^11.1.0",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.7.0",
    "next": "^16.3.8",
    "nextjs-toploader": "^3.9.17",
    "postcss": "^8.5.28",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "shadcn": "^4.1.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.1.1",
    "knip": "^6.39.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
